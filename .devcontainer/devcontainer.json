{
  "name": "Banyra",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Banyra — aperçu web",
      "onAutoForward": "notify"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "python3 scripts/banyra_dev.py start --wait 180",
  "remoteUser": "vscode"
}
